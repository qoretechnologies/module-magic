#!/usr/bin/env qore

%requires magic

%modern

%requires QUnit
%requires Mime
%requires Util

%exec-class MagicTest

class MagicTest inherits Test {
    private {
        string testDir;
    }

    constructor() : Test("MagicTest", "1.0") {
        testDir = get_script_dir();

        addTestCase("Default constructor", \testDefaultConstructor());
        addTestCase("Constructor with flags", \testConstructorWithFlags());
        addTestCase("File detection - MIME type", \testFileMimeType());
        addTestCase("File detection - MIME with encoding", \testFileMimeWithEncoding());
        addTestCase("File detection with inline flags", \testFileWithFlags());
        addTestCase("Buffer detection - string", \testBufferString());
        addTestCase("Buffer detection - binary", \testBufferBinary());
        addTestCase("Buffer detection with inline flags", \testBufferWithFlags());
        addTestCase("setFlags method", \testSetFlags());
        addTestCase("getFlags method", \testGetFlags());
        addTestCase("Error handling - non-existent file", \testNonExistentFile());
        addTestCase("Error handling - empty path", \testEmptyPath());
        addTestCase("Edge case - empty file", \testEmptyFile());
        addTestCase("Edge case - empty buffer", \testEmptyBuffer());
        addTestCase("Flag combinations", \testFlagCombinations());
        addTestCase("Binary file detection", \testBinaryFiles());
        addTestCase("Sandbox filesystem tests", \sandboxFilesystemTest());
        addTestCase("fileInfo - text file", \testFileInfoText());
        addTestCase("fileInfo - PNG file", \testFileInfoPng());
        addTestCase("fileInfo - JPEG file", \testFileInfoJpeg());
        addTestCase("bufferInfo - text", \testBufferInfoText());
        addTestCase("bufferInfo - PNG binary", \testBufferInfoPng());
        addTestCase("bufferInfo - JPEG binary", \testBufferInfoJpeg());
        addTestCase("bufferInfo - PDF header", \testBufferInfoPdf());
        addTestCase("magic_file_info function", \testMagicFileInfoFunction());
        addTestCase("magic_mime_type function", \testMagicMimeTypeFunction());
        addTestCase("magic_buffer_info function", \testMagicBufferInfoFunction());
        addTestCase("magic_buffer_mime_type function", \testMagicBufferMimeTypeFunction());
        addTestCase("fileInfo error handling", \testFileInfoErrorHandling());
        addTestCase("bufferInfo edge cases", \testBufferInfoEdgeCases());
        addTestCase("fileInfo sandbox", \testFileInfoSandbox());
        addTestCase("Convenience functions sandbox", \testConvenienceFunctionsSandbox());
        addTestCase("Negative type tests - buffer/bufferInfo", \testNegativeTypeBuffer());
        addTestCase("I/O interrupt - file operations", \testIOInterruptFile());
        addTestCase("I/O interrupt - buffer operations", \testIOInterruptBuffer());
        addTestCase("I/O interrupt - convenience functions", \testIOInterruptConvenience());
        addTestCase("Named argument calls", \testNamedArgumentCalls());

        set_return_value(main());
    }

    # Test default constructor creates Magic object with MAGIC_NONE
    testDefaultConstructor() {
        Magic m();
        assertEq(MAGIC_NONE, m.getFlags(), "Default constructor should set MAGIC_NONE");

        # Should still work - returns human-readable description
        string result = m.file(testDir + "/qore.txt");
        assertTrue(result.size() > 0, "Default constructor should produce valid output");
    }

    # Test constructor with flags
    testConstructorWithFlags() {
        Magic m(MAGIC_MIME_TYPE);
        assertEq(MAGIC_MIME_TYPE, m.getFlags(), "Constructor should set correct flags");

        Magic m2(MAGIC_MIME);
        assertEq(MAGIC_MIME, m2.getFlags(), "Constructor should set MAGIC_MIME flags");

        Magic m3(MAGIC_MIME_ENCODING);
        assertEq(MAGIC_MIME_ENCODING, m3.getFlags(), "Constructor should set MAGIC_MIME_ENCODING flags");
    }

    # Test basic file MIME type detection
    testFileMimeType() {
        Magic m(MAGIC_MIME_TYPE);
        assertEq(MimeTypeText, m.file(testDir + "/qore.txt"), "Should detect text file");
        assertEq(MimeTypeJpeg, m.file(testDir + "/qore.jpg"), "Should detect JPEG file");
        assertEq(MimeTypePng, m.file(testDir + "/qore.png"), "Should detect PNG file");
    }

    # Test MIME type with encoding (charset)
    testFileMimeWithEncoding() {
        Magic m(MAGIC_MIME);
        string result = m.file(testDir + "/qore.txt");
        assertTrue(result.regex("^text/plain"), "Should start with text/plain");
        assertTrue(result.regex("charset="), "Should include charset");
    }

    # Test file() method with inline flags parameter
    testFileWithFlags() {
        Magic m(MAGIC_NONE);

        # Use MAGIC_MIME_TYPE flag inline
        string mimeResult = m.file(testDir + "/qore.txt", MAGIC_MIME_TYPE);
        assertEq(MimeTypeText, mimeResult, "Inline MAGIC_MIME_TYPE should work");

        # Use MAGIC_MIME flag inline
        string mimeFullResult = m.file(testDir + "/qore.txt", MAGIC_MIME);
        assertTrue(mimeFullResult.regex("charset="), "Inline MAGIC_MIME should include charset");

        # Original object flags should be unchanged
        assertEq(MAGIC_NONE, m.getFlags(), "Object flags should remain unchanged");
    }

    # Test buffer detection with string data
    testBufferString() {
        Magic m(MAGIC_MIME_TYPE);

        # Plain text
        assertEq(MimeTypeText, m.buffer("Hello, World!"), "Should detect text string");

        # HTML-like content
        string htmlResult = m.buffer("<html><body>Test</body></html>");
        assertTrue(htmlResult == "text/html" || htmlResult == MimeTypeText,
            "Should detect HTML or text");

        # JSON-like content
        string jsonResult = m.buffer('{"key": "value"}');
        assertTrue(jsonResult == "application/json" || jsonResult == MimeTypeText,
            "Should detect JSON or text");
    }

    # Test buffer detection with binary data
    testBufferBinary() {
        Magic m(MAGIC_MIME_TYPE);

        # Read actual test files as binary and test buffer detection
        binary pngData = ReadOnlyFile::readBinaryFile(testDir + "/qore.png");
        string pngResult = m.buffer(pngData);
        assertEq(MimeTypePng, pngResult, "Should detect PNG from binary buffer");

        binary jpgData = ReadOnlyFile::readBinaryFile(testDir + "/qore.jpg");
        string jpegResult = m.buffer(jpgData);
        assertEq(MimeTypeJpeg, jpegResult, "Should detect JPEG from binary buffer");

        # Test with minimal magic bytes - these may return octet-stream on some systems
        # as the headers alone may not be enough for definitive detection
        binary pngHeader = <89504E470D0A1A0A>;
        string pngHeaderResult = m.buffer(pngHeader);
        assertTrue(pngHeaderResult == MimeTypePng || pngHeaderResult == "application/octet-stream",
            "Should detect PNG or octet-stream from minimal header");

        # PDF-like content (header string)
        string pdfResult = m.buffer("%PDF-1.4");
        assertEq(MimeTypePdf, pdfResult, "Should detect PDF from header string");
    }

    # Test buffer() with inline flags parameter
    testBufferWithFlags() {
        Magic m(MAGIC_NONE);

        # Use MAGIC_MIME_TYPE flag inline
        string mimeResult = m.buffer("Hello, World!", MAGIC_MIME_TYPE);
        assertEq(MimeTypeText, mimeResult, "Inline MAGIC_MIME_TYPE should work for buffer");

        # Use MAGIC_MIME flag inline
        string mimeFullResult = m.buffer("Hello, World!", MAGIC_MIME);
        assertTrue(mimeFullResult.regex("charset="), "Inline MAGIC_MIME should include charset for buffer");

        # Original object flags should be unchanged
        assertEq(MAGIC_NONE, m.getFlags(), "Object flags should remain unchanged after buffer()");
    }

    # Test setFlags method
    testSetFlags() {
        Magic m();
        assertEq(MAGIC_NONE, m.getFlags(), "Initial flags should be MAGIC_NONE");

        m.setFlags(MAGIC_MIME_TYPE);
        assertEq(MAGIC_MIME_TYPE, m.getFlags(), "setFlags should update flags");

        # Verify the new flags work
        string result = m.file(testDir + "/qore.txt");
        assertEq(MimeTypeText, result, "New flags should take effect");

        # Change flags again
        m.setFlags(MAGIC_MIME);
        assertEq(MAGIC_MIME, m.getFlags(), "setFlags should update flags again");
        result = m.file(testDir + "/qore.txt");
        assertTrue(result.regex("charset="), "Updated flags should take effect");
    }

    # Test getFlags method
    testGetFlags() {
        Magic m(MAGIC_MIME_TYPE);
        assertEq(MAGIC_MIME_TYPE, m.getFlags(), "getFlags should return correct value");

        m.setFlags(MAGIC_MIME | MAGIC_COMPRESS);
        int expected = MAGIC_MIME | MAGIC_COMPRESS;
        assertEq(expected, m.getFlags(), "getFlags should return combined flags");
    }

    testNamedArgumentCalls() {
        string text_path = testDir + "/qore.txt";

        Magic m(flags: MAGIC_MIME_TYPE);
        assertEq(MimeTypeText, m.file(path: text_path), "named file path should work");
        assertEq(MimeTypeText, m.file(path: text_path, flags: MAGIC_MIME_TYPE),
            "named file path and flags should work");
        assertEq(MimeTypeText, m.buffer(data: "Hello, World!"), "named buffer data should work");
        assertEq(MimeTypeText, m.buffer(data: "Hello, World!", flags: MAGIC_MIME_TYPE),
            "named buffer data and flags should work");

        m.setFlags(flags: MAGIC_MIME);
        assertTrue(m.file(path: text_path).regex("charset="), "named setFlags should update flags");

        assertEq(MimeTypeText, magic_mime_type(path: text_path), "named convenience path should work");
        assertEq(MimeTypeText, magic_buffer_mime_type(data: "Hello, World!"),
            "named convenience data should work");
        hash<MagicFileInfo> file_info = magic_file_info(path: text_path);
        assertEq(MimeTypeText, file_info.mime_type, "named magic_file_info should work");
        hash<MagicFileInfo> buffer_info = magic_buffer_info(data: "Hello, World!");
        assertEq(MimeTypeText, buffer_info.mime_type, "named magic_buffer_info should work");
    }

    # Test error handling for non-existent file
    testNonExistentFile() {
        Magic m(MAGIC_MIME_TYPE);

        # Without MAGIC_ERROR flag, libmagic may return a result or raise an exception
        # depending on the platform
        try {
            string result = m.file("/nonexistent/path/to/file.txt");
            # Some platforms return an error description instead of throwing
            assertTrue(result.size() > 0, "Non-existent file returned non-empty result");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("MAGIC-ERROR", ex.err, "Should raise MAGIC-ERROR exception");
        }

        # With MAGIC_ERROR flag, should definitely raise an exception
        Magic m2(MAGIC_MIME_TYPE | MAGIC_ERROR);
        assertThrows("MAGIC-ERROR", \m2.file(), "/nonexistent/path/to/file.txt");
    }

    # Test error handling for empty path
    testEmptyPath() {
        Magic m(MAGIC_MIME_TYPE | MAGIC_ERROR);

        assertThrows("MAGIC-ERROR", \m.file(), "");
    }

    # Test edge case: empty file
    testEmptyFile() {
        # Create a temporary empty file
        string emptyFile = tmp_location() + "/magic_test_empty_" + string(getpid()) + ".tmp";
        {
            File f();
            f.open(emptyFile, O_CREAT | O_WRONLY | O_TRUNC);
            f.close();
        }

        on_exit {
            unlink(emptyFile);
        }

        Magic m(MAGIC_MIME_TYPE);
        string result = m.file(emptyFile);
        # Empty files are typically detected as "inode/x-empty" or "application/x-empty"
        assertTrue(result.regex("empty") || result == MimeTypeText || result == "application/octet-stream",
            "Should handle empty file: got " + result);
    }

    # Test edge case: empty buffer
    testEmptyBuffer() {
        Magic m(MAGIC_MIME_TYPE);

        # Empty string
        string result1 = m.buffer("");
        assertTrue(result1.size() > 0, "Should handle empty string buffer");

        # Empty binary
        binary emptyBin = binary();
        string result2 = m.buffer(emptyBin);
        assertTrue(result2.size() > 0, "Should handle empty binary buffer");
    }

    # Test various flag combinations
    testFlagCombinations() {
        # MAGIC_COMPRESS - check inside compressed files
        Magic m1(MAGIC_MIME_TYPE | MAGIC_COMPRESS);
        assertTrue(m1.getFlags() == (MAGIC_MIME_TYPE | MAGIC_COMPRESS), "Combined flags should work");

        # MAGIC_SYMLINK - follow symlinks
        Magic m2(MAGIC_MIME_TYPE | MAGIC_SYMLINK);
        assertTrue(m2.getFlags() == (MAGIC_MIME_TYPE | MAGIC_SYMLINK), "SYMLINK flag should work");

        # MAGIC_CONTINUE - return all matches
        Magic m3(MAGIC_MIME_TYPE | MAGIC_CONTINUE);
        assertTrue(m3.getFlags() == (MAGIC_MIME_TYPE | MAGIC_CONTINUE), "CONTINUE flag should work");

        # Multiple flags
        int multiFlags = MAGIC_MIME_TYPE | MAGIC_SYMLINK | MAGIC_COMPRESS;
        Magic m4(multiFlags);
        assertEq(multiFlags, m4.getFlags(), "Multiple flags should work");
    }

    # Test binary file detection
    testBinaryFiles() {
        Magic m(MAGIC_MIME_TYPE);

        # Test actual binary files in test directory
        assertEq(MimeTypeJpeg, m.file(testDir + "/qore.jpg"), "Should detect JPEG");
        assertEq(MimeTypePng, m.file(testDir + "/qore.png"), "Should detect PNG");

        # Test with MAGIC_MIME for full MIME with charset
        Magic m2(MAGIC_MIME);
        string jpegResult = m2.file(testDir + "/qore.jpg");
        assertTrue(jpegResult.regex("^image/jpeg"), "Should start with image/jpeg");

        string pngResult = m2.file(testDir + "/qore.png");
        assertTrue(pngResult.regex("^image/png"), "Should start with image/png");
    }

    # Test filesystem sandbox
    sandboxFilesystemTest() {
        # Test that filesystem sandbox blocks file access outside allowed paths

        # Create a test file in /tmp
        string testFilePath = "/tmp/magic_sandbox_test_" + getpid() + ".txt";
        {
            File f();
            f.open2(testFilePath, O_CREAT | O_WRONLY | O_TRUNC);
            f.write("This is a test file");
        }
        on_exit unlink(testFilePath);

        # Create a sandboxed program with /var as root (so /tmp is outside)
        Program p(PO_MODERN);
        p.loadModule("magic");

        p.parse(sprintf("
            string sub test_magic_file() {
                Magic m(MAGIC_MIME_TYPE);
                return m.file('%s');
            }
        ", testFilePath), "sandbox_magic_test");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/var");
        p.setSandboxManager(sm);

        # Test that Magic::file() is blocked when file is outside sandbox
        bool caught = False;
        try {
            p.callFunction("test_magic_file");
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertEq("FILESYSTEM-ACCESS-DENIED", ex.err, "Magic file access blocked with correct error");
        }
        assertTrue(caught, "Magic file access outside sandbox was blocked");

        # Test that buffer detection works with any sandbox (no file access)
        Program p2(PO_MODERN);
        p2.loadModule("magic");

        p2.parse("
            string sub test_magic_buffer() {
                Magic m(MAGIC_MIME_TYPE);
                return m.buffer('Hello, World!');
            }
        ", "sandbox_magic_buffer_test");
        p2.setSandboxManager(sm);

        string result = p2.callFunction("test_magic_buffer");
        assertEq("text/plain", result, "Magic buffer detection works with filesystem sandbox");

        # Test that file access works when file is in allowed path
        SandboxManager sm3();
        sm3.setFilesystemSandboxRoot("/tmp");
        Program p3(PO_MODERN);
        p3.loadModule("magic");

        p3.parse(sprintf("
            string sub test_allowed_magic() {
                Magic m(MAGIC_MIME_TYPE);
                return m.file('%s');
            }
        ", testFilePath), "sandbox_allowed_magic_test");
        p3.setSandboxManager(sm3);

        result = p3.callFunction("test_allowed_magic");
        assertEq("text/plain", result, "Magic file access inside sandbox works");
    }

    # Test fileInfo() for text file
    testFileInfoText() {
        Magic m();
        hash<MagicFileInfo> info = m.fileInfo(testDir + "/qore.txt");

        assertEq("text/plain", info.mime_type, "fileInfo text MIME type");
        assertTrue(info.mime_encoding.size() > 0, "fileInfo text encoding not empty");
        assertTrue(info.description.size() > 0, "fileInfo text description not empty");
        assertTrue(info.is_text, "fileInfo text is_text should be True");
        assertEq("text", info.type_category, "fileInfo text type_category");
    }

    # Test fileInfo() for PNG file
    testFileInfoPng() {
        Magic m();
        hash<MagicFileInfo> info = m.fileInfo(testDir + "/qore.png");

        assertEq("image/png", info.mime_type, "fileInfo PNG MIME type");
        assertEq("binary", info.mime_encoding, "fileInfo PNG encoding");
        assertTrue(info.description.size() > 0, "fileInfo PNG description not empty");
        assertFalse(info.is_text, "fileInfo PNG is_text should be False");
        assertEq("image", info.type_category, "fileInfo PNG type_category");
    }

    # Test fileInfo() for JPEG file
    testFileInfoJpeg() {
        Magic m();
        hash<MagicFileInfo> info = m.fileInfo(testDir + "/qore.jpg");

        assertEq("image/jpeg", info.mime_type, "fileInfo JPEG MIME type");
        assertEq("binary", info.mime_encoding, "fileInfo JPEG encoding");
        assertTrue(info.description.size() > 0, "fileInfo JPEG description not empty");
        assertFalse(info.is_text, "fileInfo JPEG is_text should be False");
        assertEq("image", info.type_category, "fileInfo JPEG type_category");
    }

    # Test bufferInfo() for text string
    testBufferInfoText() {
        Magic m();
        hash<MagicFileInfo> info = m.bufferInfo("Hello, World!");

        assertEq("text/plain", info.mime_type, "bufferInfo text MIME type");
        assertTrue(info.mime_encoding.size() > 0, "bufferInfo text encoding not empty");
        assertTrue(info.description.size() > 0, "bufferInfo text description not empty");
        assertTrue(info.is_text, "bufferInfo text is_text should be True");
        assertEq("text", info.type_category, "bufferInfo text type_category");
    }

    # Test bufferInfo() for PNG binary data
    testBufferInfoPng() {
        Magic m();
        binary pngData = ReadOnlyFile::readBinaryFile(testDir + "/qore.png");
        hash<MagicFileInfo> info = m.bufferInfo(pngData);

        assertEq("image/png", info.mime_type, "bufferInfo PNG MIME type");
        assertEq("binary", info.mime_encoding, "bufferInfo PNG encoding");
        assertTrue(info.description.size() > 0, "bufferInfo PNG description not empty");
        assertFalse(info.is_text, "bufferInfo PNG is_text should be False");
        assertEq("image", info.type_category, "bufferInfo PNG type_category");
    }

    # Test bufferInfo() for JPEG binary data
    testBufferInfoJpeg() {
        Magic m();
        binary jpgData = ReadOnlyFile::readBinaryFile(testDir + "/qore.jpg");
        hash<MagicFileInfo> info = m.bufferInfo(jpgData);

        assertEq("image/jpeg", info.mime_type, "bufferInfo JPEG MIME type");
        assertEq("binary", info.mime_encoding, "bufferInfo JPEG encoding");
        assertTrue(info.description.size() > 0, "bufferInfo JPEG description not empty");
        assertFalse(info.is_text, "bufferInfo JPEG is_text should be False");
        assertEq("image", info.type_category, "bufferInfo JPEG type_category");
    }

    # Test bufferInfo() for PDF header string
    testBufferInfoPdf() {
        Magic m();
        hash<MagicFileInfo> info = m.bufferInfo("%PDF-1.4");

        assertEq("application/pdf", info.mime_type, "bufferInfo PDF MIME type");
        assertTrue(info.description.size() > 0, "bufferInfo PDF description not empty");
        assertFalse(info.is_text, "bufferInfo PDF is_text should be False");
        assertEq("application", info.type_category, "bufferInfo PDF type_category");
    }

    # Test magic_file_info() convenience function
    testMagicFileInfoFunction() {
        hash<MagicFileInfo> textInfo = magic_file_info(testDir + "/qore.txt");
        assertEq("text/plain", textInfo.mime_type, "magic_file_info text MIME type");
        assertTrue(textInfo.is_text, "magic_file_info text is_text");
        assertEq("text", textInfo.type_category, "magic_file_info text type_category");

        hash<MagicFileInfo> pngInfo = magic_file_info(testDir + "/qore.png");
        assertEq("image/png", pngInfo.mime_type, "magic_file_info PNG MIME type");
        assertFalse(pngInfo.is_text, "magic_file_info PNG is_text");
        assertEq("image", pngInfo.type_category, "magic_file_info PNG type_category");

        hash<MagicFileInfo> jpgInfo = magic_file_info(testDir + "/qore.jpg");
        assertEq("image/jpeg", jpgInfo.mime_type, "magic_file_info JPEG MIME type");
        assertFalse(jpgInfo.is_text, "magic_file_info JPEG is_text");
        assertEq("image", jpgInfo.type_category, "magic_file_info JPEG type_category");
    }

    # Test magic_mime_type() convenience function
    testMagicMimeTypeFunction() {
        assertEq("text/plain", magic_mime_type(testDir + "/qore.txt"), "magic_mime_type text");
        assertEq("image/png", magic_mime_type(testDir + "/qore.png"), "magic_mime_type PNG");
        assertEq("image/jpeg", magic_mime_type(testDir + "/qore.jpg"), "magic_mime_type JPEG");
    }

    # Test magic_buffer_info() convenience function
    testMagicBufferInfoFunction() {
        hash<MagicFileInfo> textInfo = magic_buffer_info("Hello, World!");
        assertEq("text/plain", textInfo.mime_type, "magic_buffer_info text MIME type");
        assertTrue(textInfo.is_text, "magic_buffer_info text is_text");
        assertEq("text", textInfo.type_category, "magic_buffer_info text type_category");

        binary pngData = ReadOnlyFile::readBinaryFile(testDir + "/qore.png");
        hash<MagicFileInfo> pngInfo = magic_buffer_info(pngData);
        assertEq("image/png", pngInfo.mime_type, "magic_buffer_info PNG MIME type");
        assertFalse(pngInfo.is_text, "magic_buffer_info PNG is_text");
        assertEq("image", pngInfo.type_category, "magic_buffer_info PNG type_category");
    }

    # Test magic_buffer_mime_type() convenience function
    testMagicBufferMimeTypeFunction() {
        assertEq("text/plain", magic_buffer_mime_type("Hello, World!"), "magic_buffer_mime_type text");

        binary pngData = ReadOnlyFile::readBinaryFile(testDir + "/qore.png");
        assertEq("image/png", magic_buffer_mime_type(pngData), "magic_buffer_mime_type PNG");

        binary jpgData = ReadOnlyFile::readBinaryFile(testDir + "/qore.jpg");
        assertEq("image/jpeg", magic_buffer_mime_type(jpgData), "magic_buffer_mime_type JPEG");

        assertEq("application/pdf", magic_buffer_mime_type("%PDF-1.4"), "magic_buffer_mime_type PDF");
    }

    # Test fileInfo error handling
    testFileInfoErrorHandling() {
        Magic m();

        # Non-existent file with MAGIC_ERROR - fileInfo always uses MAGIC_NONE and MAGIC_MIME internally
        # but still checks filesystem access
        assertThrows("MAGIC-ERROR", \m.fileInfo(), "/nonexistent/path/to/file.txt");

        # Also test the convenience function
        assertThrows("MAGIC-ERROR", \magic_file_info(), "/nonexistent/path/to/file.txt");

        # Empty file edge case
        string emptyFile = tmp_location() + "/magic_test_empty_info_" + string(getpid()) + ".tmp";
        {
            File f();
            f.open(emptyFile, O_CREAT | O_WRONLY | O_TRUNC);
            f.close();
        }
        on_exit unlink(emptyFile);

        hash<MagicFileInfo> info = m.fileInfo(emptyFile);
        assertTrue(info.mime_type.size() > 0, "fileInfo empty file should have MIME type");
        assertTrue(info.description.size() > 0, "fileInfo empty file should have description");
    }

    # Test bufferInfo edge cases
    testBufferInfoEdgeCases() {
        Magic m();

        # Empty string buffer
        hash<MagicFileInfo> emptyStrInfo = m.bufferInfo("");
        assertTrue(emptyStrInfo.mime_type.size() > 0, "bufferInfo empty string should have MIME type");
        assertTrue(emptyStrInfo.description.size() > 0, "bufferInfo empty string should have description");

        # Empty binary buffer
        hash<MagicFileInfo> emptyBinInfo = m.bufferInfo(binary());
        assertTrue(emptyBinInfo.mime_type.size() > 0, "bufferInfo empty binary should have MIME type");
        assertTrue(emptyBinInfo.description.size() > 0, "bufferInfo empty binary should have description");

        # Also test convenience function with empty data
        hash<MagicFileInfo> emptyFuncInfo = magic_buffer_info("");
        assertTrue(emptyFuncInfo.mime_type.size() > 0, "magic_buffer_info empty string should have MIME type");
    }

    # Test fileInfo() respects filesystem sandbox
    testFileInfoSandbox() {
        # Create a test file in /tmp
        string testFilePath = "/tmp/magic_fileinfo_sandbox_test_" + getpid() + ".txt";
        {
            File f();
            f.open2(testFilePath, O_CREAT | O_WRONLY | O_TRUNC);
            f.write("This is a test file for fileInfo sandbox");
        }
        on_exit unlink(testFilePath);

        # Create a sandboxed program with /var as root (so /tmp is outside)
        Program p(PO_MODERN);
        p.loadModule("magic");

        p.parse(sprintf("
            hash<MagicFileInfo> sub test_fileinfo() {
                Magic m();
                return m.fileInfo('%s');
            }
        ", testFilePath), "sandbox_fileinfo_test");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/var");
        p.setSandboxManager(sm);

        # Test that Magic::fileInfo() is blocked when file is outside sandbox
        bool caught = False;
        try {
            p.callFunction("test_fileinfo");
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertEq("FILESYSTEM-ACCESS-DENIED", ex.err, "fileInfo access blocked with correct error");
        }
        assertTrue(caught, "fileInfo outside sandbox was blocked");

        # Test that bufferInfo() works with any sandbox
        Program p2(PO_MODERN);
        p2.loadModule("magic");

        p2.parse("
            hash<MagicFileInfo> sub test_bufferinfo() {
                Magic m();
                return m.bufferInfo('Hello, World!');
            }
        ", "sandbox_bufferinfo_test");
        p2.setSandboxManager(sm);

        hash<MagicFileInfo> result = p2.callFunction("test_bufferinfo");
        assertEq("text/plain", result.mime_type, "bufferInfo works with filesystem sandbox");

        # Test that fileInfo works when file is in allowed path
        SandboxManager sm3();
        sm3.setFilesystemSandboxRoot("/tmp");
        Program p3(PO_MODERN);
        p3.loadModule("magic");

        p3.parse(sprintf("
            hash<MagicFileInfo> sub test_allowed_fileinfo() {
                Magic m();
                return m.fileInfo('%s');
            }
        ", testFilePath), "sandbox_allowed_fileinfo_test");
        p3.setSandboxManager(sm3);

        hash<MagicFileInfo> allowed = p3.callFunction("test_allowed_fileinfo");
        assertEq("text/plain", allowed.mime_type, "fileInfo inside sandbox works");
    }

    # Test convenience functions respect filesystem sandbox
    testConvenienceFunctionsSandbox() {
        # Create a test file in /tmp
        string testFilePath = "/tmp/magic_func_sandbox_test_" + getpid() + ".txt";
        {
            File f();
            f.open2(testFilePath, O_CREAT | O_WRONLY | O_TRUNC);
            f.write("This is a test file for function sandbox");
        }
        on_exit unlink(testFilePath);

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/var");

        # Test magic_file_info() is blocked
        {
            Program p(PO_MODERN);
            p.loadModule("magic");
            p.parse(sprintf("
                hash<MagicFileInfo> sub test_func_file_info() {
                    return magic_file_info('%s');
                }
            ", testFilePath), "sandbox_func_file_info_test");
            p.setSandboxManager(sm);

            bool caught = False;
            try {
                p.callFunction("test_func_file_info");
            } catch (hash<ExceptionInfo> ex) {
                caught = True;
                assertEq("FILESYSTEM-ACCESS-DENIED", ex.err,
                    "magic_file_info access blocked with correct error");
            }
            assertTrue(caught, "magic_file_info outside sandbox was blocked");
        }

        # Test magic_mime_type() is blocked
        {
            Program p(PO_MODERN);
            p.loadModule("magic");
            p.parse(sprintf("
                string sub test_func_mime_type() {
                    return magic_mime_type('%s');
                }
            ", testFilePath), "sandbox_func_mime_type_test");
            p.setSandboxManager(sm);

            bool caught = False;
            try {
                p.callFunction("test_func_mime_type");
            } catch (hash<ExceptionInfo> ex) {
                caught = True;
                assertEq("FILESYSTEM-ACCESS-DENIED", ex.err,
                    "magic_mime_type access blocked with correct error");
            }
            assertTrue(caught, "magic_mime_type outside sandbox was blocked");
        }

        # Test buffer functions work with sandbox (no file access needed)
        {
            Program p(PO_MODERN);
            p.loadModule("magic");
            p.parse("
                hash<MagicFileInfo> sub test_func_buffer_info() {
                    return magic_buffer_info('Hello, World!');
                }
            ", "sandbox_func_buffer_info_test");
            p.setSandboxManager(sm);

            hash<MagicFileInfo> result = p.callFunction("test_func_buffer_info");
            assertEq("text/plain", result.mime_type, "magic_buffer_info works with sandbox");
        }

        {
            Program p(PO_MODERN);
            p.loadModule("magic");
            p.parse("
                string sub test_func_buffer_mime_type() {
                    return magic_buffer_mime_type('Hello, World!');
                }
            ", "sandbox_func_buffer_mime_type_test");
            p.setSandboxManager(sm);

            string result = p.callFunction("test_func_buffer_mime_type");
            assertEq("text/plain", result, "magic_buffer_mime_type works with sandbox");
        }
    }

    # Test that passing invalid types to buffer/bufferInfo raises parse-time type errors
    testNegativeTypeBuffer() {
        # With %modern (PO_MODERN), the data type only accepts string|binary.
        # Passing an int should raise a parse-time type error.

        # Test Magic::buffer() with wrong type
        assertThrows("PARSE-TYPE-ERROR", sub() {
            Program p(PO_MODERN);
            p.loadModule("magic");
            p.parse("
                string sub test_buffer_int() {
                    Magic m(MAGIC_MIME_TYPE);
                    return m.buffer(42);
                }
            ", "neg_buffer_int_test");
        });

        # Test Magic::bufferInfo() with wrong type
        assertThrows("PARSE-TYPE-ERROR", sub() {
            Program p(PO_MODERN);
            p.loadModule("magic");
            p.parse("
                hash<MagicFileInfo> sub test_bufferinfo_int() {
                    Magic m();
                    return m.bufferInfo(42);
                }
            ", "neg_bufferinfo_int_test");
        });

        # Test magic_buffer_info() with wrong type
        assertThrows("PARSE-TYPE-ERROR", sub() {
            Program p(PO_MODERN);
            p.loadModule("magic");
            p.parse("
                hash<MagicFileInfo> sub test_func_buffer_info_int() {
                    return magic_buffer_info(42);
                }
            ", "neg_func_buffer_info_int_test");
        });

        # Test magic_buffer_mime_type() with wrong type
        assertThrows("PARSE-TYPE-ERROR", sub() {
            Program p(PO_MODERN);
            p.loadModule("magic");
            p.parse("
                string sub test_func_buffer_mime_type_int() {
                    return magic_buffer_mime_type(42);
                }
            ", "neg_func_buffer_mime_type_int_test");
        });
    }

    # Test I/O interrupt for file operations (pre-requested interrupt)
    testIOInterruptFile() {
        # Create a test file
        string testFilePath = "/tmp/magic_interrupt_test_" + getpid() + ".txt";
        {
            File f();
            f.open2(testFilePath, O_CREAT | O_WRONLY | O_TRUNC);
            f.write("test interrupt data");
        }
        on_exit unlink(testFilePath);

        SandboxManager sm();
        sm.requestInterrupt();

        # Test Magic::file() is interrupted
        {
            Program p(PO_MODERN);
            p.loadModule("magic");
            p.parse(sprintf("
                string sub test_file() {
                    Magic m(MAGIC_MIME_TYPE);
                    return m.file('%s');
                }
            ", testFilePath), "interrupt_file_test");
            p.setSandboxManager(sm);

            assertThrows("PROGRAM-INTERRUPTED", \p.callFunction(), "test_file");
        }

        # Test Magic::fileInfo() is interrupted
        {
            Program p(PO_MODERN);
            p.loadModule("magic");
            p.parse(sprintf("
                hash<MagicFileInfo> sub test_fileinfo() {
                    Magic m();
                    return m.fileInfo('%s');
                }
            ", testFilePath), "interrupt_fileinfo_test");
            p.setSandboxManager(sm);

            assertThrows("PROGRAM-INTERRUPTED", \p.callFunction(), "test_fileinfo");
        }
    }

