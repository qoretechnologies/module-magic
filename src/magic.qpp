#include <qore/Qore.h>
#include "qoremagic.h"

/** @defgroup magic_constants libmagic Constants
*/
///@{
namespace Qore::Magic;
//! No flags
const MAGIC_NONE              = 0x000000;
//! Turn on debugging
const MAGIC_DEBUG             = 0x000001;
//! Follow symlinks
const MAGIC_SYMLINK           = 0x000002;
//! Check inside compressed files
const MAGIC_COMPRESS          = 0x000004;
//! Look at the contents of devices
const MAGIC_DEVICES           = 0x000008;
//! Return the MIME type
const MAGIC_MIME_TYPE         = 0x000010;
//! Return all matches
const MAGIC_CONTINUE          = 0x000020;
//! Print warnings to stderr
const MAGIC_CHECK             = 0x000040;
//! Restore access time on exit
const MAGIC_PRESERVE_ATIME    = 0x000080;
//! Don't translate unprintable chars
const MAGIC_RAW               = 0x000100;
//! Handle ENOENT etc as real errors
const MAGIC_ERROR             = 0x000200;
//! Return the MIME encoding
const MAGIC_MIME_ENCODING     = 0x000400;
//! Returns MIME type with encoding
const MAGIC_MIME              = 0x000410;
//! Return the Apple creator and type
const MAGIC_APPLE             = 0x000800;
//! Don't check for compressed files
const MAGIC_NO_CHECK_COMPRESS = 0x001000;
//! Don't check for tar files
const MAGIC_NO_CHECK_TAR      = 0x002000;
//! Don't check magic entries
const MAGIC_NO_CHECK_SOFT     = 0x004000;
//! Don't check application type
const MAGIC_NO_CHECK_APPTYPE  = 0x008000;
//! Don't check for elf details
const MAGIC_NO_CHECK_ELF      = 0x010000;
//! Don't check for text files
const MAGIC_NO_CHECK_TEXT     = 0x020000;
//! Don't check for cdf files
const MAGIC_NO_CHECK_CDF      = 0x040000;
//! Don't check tokens
const MAGIC_NO_CHECK_TOKENS   = 0x100000;
//! Don't check text encodings
const MAGIC_NO_CHECK_ENCODING = 0x200000;
//! No built-in tests only consult the magic file
const MAGIC_NO_CHECK_BUILTIN  = 0x3fb000;
///@}

//! Structured file information returned by @ref Magic::fileInfo() "Magic::fileInfo()", @ref Magic::bufferInfo() "Magic::bufferInfo()", and convenience functions
/** @since magic 2.0
*/
hashdecl MagicFileInfo {
    //! Human-readable description (e.g. "PNG image data, 800 x 600, 8-bit/color RGBA")
    string description;
    //! MIME type (e.g. "image/png")
    string mime_type;
    //! MIME encoding (e.g. "binary", "us-ascii", "utf-8")
    string mime_encoding;
    //! True if mime_type starts with "text/"
    bool is_text;
    //! Type category (e.g. "image", "text", "application")
    string type_category;
}

//! A low level wrapper around libmagic
/**
Example of use:

@code{.py}
Magic m(MAGIC_MIME_TYPE);
printf("%y\n", m.file("/etc/hosts"));
# Output: "text/plain"

Magic m2(MAGIC_MIME);
printf("%y\n", m2.file("/etc/hosts"));
# Output: "text/plain; charset=us-ascii"
@endcode
 */
qclass Magic [arg=QoreMagic* priv; dom=FILESYSTEM; ns=Qore::Magic];

//! Constructs a dummy @see MAGIC_NONE instance
/**
 */
Magic::constructor() {
    self->setPrivate(CID_MAGIC, new QoreMagic(xsink));
}

//! Constructs specialized instance
/** @param flags features set based on @ref magic_constants
 */
Magic::constructor(softint flags) [flags=NAMED_ARGS] {
    self->setPrivate(CID_MAGIC, new QoreMagic((int)flags, xsink));
}

//! Resets new flags/features based on @ref magic_constants
/** @param flags New flags to replace old settings.
*/
Magic::setFlags(softint flags) [flags=NAMED_ARGS] {
    priv->setFlags(flags, xsink);
}

//! Returns the current flags/features
/** @retval int the current flags value
*/
int Magic::getFlags() {
    return priv->getFlags();
}

//! Returns magic info for a file (path)
/** @param path a path to file to be examined
    @retval string a text with requested info
*/
string Magic::file(softstring path) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    return priv->file(path, xsink);
}

//! Returns magic info for a file (path)
/** @param path a path to file to be examined
    @param flags settings flags
    @retval string a text with requested info
*/
string Magic::file(softstring path, softint flags) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    return priv->file(path, flags, xsink);
}

//! Returns magic info for a data buffer
/** @param data a data to file to be examined
    @retval string a text with requested info
*/
string Magic::buffer(data data) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    return priv->buffer(data, xsink);
}

//! Returns magic info for a data buffer
/** @param data a data to file to be examined
    @param flags settings flags
    @retval string a text with requested info
*/
string Magic::buffer(data data, softint flags) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    return priv->buffer(data, flags, xsink);
}

//! Returns structured file information including MIME type, encoding, and description
/** @param path a path to file to be examined

    @return a @ref MagicFileInfo hash with all file information

    @par Example:
    @code{.py}
Magic m();
hash<MagicFileInfo> info = m.fileInfo("/etc/hosts");
printf("MIME: %s, encoding: %s, is_text: %y\n", info.mime_type, info.mime_encoding, info.is_text);
    @endcode

    @since magic 2.0
*/
hash<MagicFileInfo> Magic::fileInfo(softstring path) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    return priv->fileInfo(path, xsink);
}

//! Returns structured buffer information including MIME type, encoding, and description
/** @param data a data buffer to be examined

    @return a @ref MagicFileInfo hash with all buffer information

    @par Example:
    @code{.py}
Magic m();
hash<MagicFileInfo> info = m.bufferInfo("Hello, World!");
printf("MIME: %s, encoding: %s, is_text: %y\n", info.mime_type, info.mime_encoding, info.is_text);
    @endcode

    @since magic 2.0
*/
hash<MagicFileInfo> Magic::bufferInfo(data data) [dom=FILESYSTEM;flags=NAMED_ARGS] {
    return priv->bufferInfo(data, xsink);
}
